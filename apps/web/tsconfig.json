{
  "extends": "@ganatrack/tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@ganatrack/shared-types": ["../../packages/shared-types/src"]
    },
    "skipLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/modules/**/*.ts",
    "src/modules/**/*.tsx",
    "src/shared/**/*.ts",
    "src/shared/**/*.tsx",
    "src/store/**/*.ts",
    "src/store/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.mock.ts",
    "src/tests",
    "tests",
    "src/sw.ts"
  ]
}
